---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import MobileTease from '../components/MobileTease.astro';
const APP_URL = 'https://app.audioask.ai';

// Variante B de la page d'accueil, pour comparaison avec la version servie
// sur « / ». Positionnement différent, même design system : aucun composant
// ni style propre à cette page en dehors de la liste à puces ci-dessous.
//
// Les sections inchangées (tarifs, teaser Pro, appel à l'action final,
// bibliothèque partagée) lisent la même source que la home A — la collection
// « home ». Une modification de la grille tarifaire dans /admin s'applique
// donc aux deux pages, sans risque de divergence.
const t = (await getEntry('home', 'fr')).data;
const { discover, library, pricing, pro, finalCta } = t;

// Les textes propres à la variante sont ici plutôt que dans une collection :
// la page est un test, elle doit pouvoir disparaître d'un seul coup. S'ils
// devaient devenir définitifs, les migrer vers « home » comme pour la home A.
const heroB = {
  pill: 'App web & mobile',
  title: 'Vous écoutez des heures de podcasts.<br> Gardez-en chaque idée.',
  lede: "Transcrivez, cherchez et interrogez chaque épisode. L'IA répond avec des citations horodatées — vérifiables en un clic, pas des résumés flous.",
  ctaLabel: 'Essayer gratuitement',
  highlights: ['Gratuit. Sans carte.', '1h de transcription offerte'],
};

const trust = {
  items: ['🇨🇭 Swiss Made', "🇪🇺 Hébergé dans l'UE", '🔒 RGPD'],
  note: "Vos fichiers ne servent pas à l'entraînement des modèles.",
};

const valueProps = {
  eyebrow: 'Ce qui change pour vous',
  title: 'Le savoir de vos podcasts, enfin exploitable.',
  lede: "Pas une énième app d'écoute. Un outil pour retrouver, vérifier et réutiliser ce que vous entendez.",
  cards: [
    { title: 'Ne reperdez plus une idée entendue.',
      text: 'Un mot, un nom, une notion → Audioask vous emmène pile sur le passage, dans tous vos épisodes.' },
    { title: 'Des réponses avec preuve, pas des hallucinations.',
      text: 'Citation horodatée vérifiable en un clic — la différence avec un chatbot généraliste.' },
    { title: 'Votre veille podcast tourne toute seule.',
      text: 'Chaque nouvel épisode transcrit, analysé et livré — bibliothèque, email ou Slack.' },
    { title: 'Des milliers d\'épisodes déjà transcrits.',
      text: "Accès instantané, zéro crédit — l'effet réseau de la bibliothèque commune joue pour vous." },
  ],
};

const ask = {
  eyebrow: 'Interroger',
  title: "Posez vos questions. L'épisode répond, sources à l'appui.",
  lede: "En langage naturel, dans votre langue. Chaque réponse s'appuie sur la transcription et renvoie au passage exact.",
  points: [
    'Citations horodatées, cliquables et vérifiables — jamais inventées.',
    'Identification des intervenants, pour savoir qui a dit quoi.',
    'Ce que ChatGPT et Gemini ne font pas sur de l\'audio long.',
  ],
};
---

<Layout
  title="Audioask — Interrogez vos podcasts, réponses sourcées et horodatées"
  description="Transcrivez et interrogez n'importe quel podcast. L'IA répond avec des citations horodatées vérifiables. Gratuit, sans carte."
  activePage="home"
  lang="fr"
  noindex={true}
>

<!-- HERO -->
<section class="hero dotbg">
  <div class="container">
    <div class="hero-copy">
      <div class="hero-eyebrow">
        <span class="pill">{heroB.pill}</span>
      </div>
      <h1 id="hero-h1" set:html={heroB.title}></h1>
      <p class="lede">{heroB.lede}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary lg" href={`${APP_URL}/signup`}>{heroB.ctaLabel} <span class="arrow">→</span></a>
      </div>
      <div class="hero-meta">
        {heroB.highlights.map(item => <span class="dotcheck">{item}</span>)}
      </div>
      <!-- Barre de confiance : reprise du pied de page, où elle reste aussi.
           Variante claire de .trust-row, le style d'origine étant calibré pour
           le fond sombre du footer. -->
      <div class="trust-row on-light">
        {trust.items.map(item => <span>{item}</span>)}
        <span class="trust-note">{trust.note}</span>
      </div>
    </div>

    <!-- HERO CAROUSEL -->
    <div class="product-stage" id="product-stage" style="margin-top: 60px;">

          <div class="float seq" style="top: 38px; left: -8px; max-width: 220px; animation-delay: 0.5s;">
            <span class="lbl">Bibliothèque commune</span>
            <span class="val" style="font-family: var(--serif); font-size: 26px; line-height: 1; color: var(--accent-ink); letter-spacing: -0.02em;">+185M</span>
            <span style="font-size: 12px; color: var(--ink-3);">épisodes déjà accessibles</span>
          </div>

          <div class="float seq" style="top: 220px; left: -28px; max-width: 200px; animation-delay: 1.3s;">
            <span class="lbl">Signet · 12:42</span>
            <span style="font-size: 13px; color: var(--ink); line-height: 1.4;">« On a parié sur CUDA quand personne n'y croyait. »</span>
            <span style="font-size: 11px; color: var(--ink-3); margin-top: 2px;">— Jensen Huang</span>
          </div>

          <div class="float seq" style="top: 110px; right: -16px; max-width: 240px; animation-delay: 2.1s;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="width: 22px; height: 22px; border-radius: 6px; background: var(--accent-soft); color: var(--accent); display: flex; align-items: center; justify-content: center;">⚡</span>
              <span class="lbl" style="margin: 0;">Automation</span>
            </div>
            <span style="font-size: 13px; color: var(--ink); line-height: 1.4;">Chaque nouvel épisode de <b>Acquired</b> sera traité automatiquement.</span>
          </div>

          <div class="float seq" style="bottom: 90px; right: -36px; max-width: 220px; animation-delay: 2.9s;">
            <span class="lbl">Recherche globale</span>
            <span style="font-size: 13px; color: var(--ink); line-height: 1.4;">3 épisodes parlent de <span style="background: var(--accent-soft); padding: 1px 4px; border-radius: 3px; color: var(--accent-ink);">tokenomics</span></span>
          </div>

          <div class="app-card" id="hero-app">
          <div class="app-toolbar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="url">audioask.ai/feed/channel/acquired</span>
          </div>
          <div class="app-shell">
            <aside class="app-side">
              <div class="brand"><span class="brand-mark">A</span><span>Audioask</span></div>
              <div class="nav">
                <div class="nav-item"><svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 4h10M3 8h10M3 12h6"/></svg>Feed</div>
                <div class="nav-item"><svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="7" r="4"/><path d="M11 11l3 3"/></svg>Recherche</div>
                <div class="nav-item on"><svg class="ico" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 3v11M5 3v11M9 3l4 11M12 3v11"/></svg>My Audioask</div>
              </div>
              <div class="group-label">CHANNELS FAVORIS</div>
              <div class="nav">
                <div class="channel on"><img class="ch-cover" src="/assets/pod-acquired.jpg" alt="">Acquired</div>
                <div class="channel"><img class="ch-cover" src="/assets/pod-tkp.jpg" alt="">The Knowledge Project</div>
                <div class="channel"><img class="ch-cover" src="/assets/pod-lex.jpg" alt="">Lex Fridman</div>
                <div class="channel"><img class="ch-cover" src="/assets/pod-huberman.jpg" alt="">Huberman Lab</div>
              </div>
              <div class="group-label">PLAYLISTS</div>
              <div class="nav">
                <div class="channel"><span style="width:14px;height:14px;border-radius:3px;background:rgba(26,22,20,0.10);"></span>Business · 12</div>
                <div class="channel"><span style="width:14px;height:14px;border-radius:3px;background:rgba(26,22,20,0.10);"></span>Pour le trajet · 6</div>
              </div>
            </aside>
            <main class="app-main">
                <div class="crumbs">FEED › CHANNEL · <span class="curr">ACQUIRED</span></div>
                <div class="ep-head">
                  <div class="ep-cover" style="padding: 0; overflow: hidden;">
                    <img src="/assets/acquired-cover.jpg" alt="Acquired" style="width: 88px; height: 88px; object-fit: cover; display: block; border-radius: 12px;">
                  </div>
                  <div style="flex: 1; min-width: 0;">
                    <div class="ep-title">#119 — Nvidia&nbsp;: la décennie qui change tout</div>
                    <div class="ep-author">Ben Gilbert &amp; David Rosenthal · 2h 47min</div>
                    <div class="ep-stats">
                      <div class="ep-stat"><b>126</b>passages</div>
                      <div class="ep-stat"><b>2</b>intervenants</div>
                      <div class="ep-stat"><b>4</b>réponses favorites</div>
                      <div class="ep-stat"><b>7</b>signets</div>
                    </div>
                  </div>
                  <div class="ep-actions">
                    <span class="chip"><span style="color: var(--ink-3); font-size: 14px;">↗</span>Partager</span>
                    <span class="chip accent">✦ Audioask</span>
                  </div>
                </div>
                <div class="transcript">
                  <div class="t-row"><span class="ts">00:00</span><span><span class="speak host">BEN</span>Bienvenue dans cet épisode où nous allons retracer l'histoire de Nvidia, de ses débuts en 1993 à sa position actuelle…</span></div>
                  <div class="t-row"><span class="ts">04:18</span><span><span class="speak host">DAVID</span>Avant Nvidia, le marché des GPU était dominé par 3DFX, Matrox, ATI…</span></div>
                  <div class="t-row bookmarked"><span class="ts">12:42</span><span><span class="speak guest">JENSEN</span><span class="quote">« On a parié sur CUDA quand personne n'y croyait. C'est devenu notre fossé concurrentiel le plus profond. »</span></span></div>
                  <div class="t-row"><span class="ts">19:30</span><span><span class="speak host">BEN</span>Et c'est exactement à ce moment-là que la stratégie a basculé. Le marché des datacenters…</span></div>
                  <div class="t-row"><span class="ts">28:05</span><span><span class="speak guest">JENSEN</span>Notre conviction&nbsp;: chaque watt utilisé doit servir à accélérer un calcul utile.</span></div>
                  <div class="t-row"><span class="ts">38:50</span><span><span class="speak host">DAVID</span>Le tournant de 2022, c'est l'explosion de la demande pour l'IA générative…</span></div>
                </div>
            </main>
            <aside class="app-ai">
              <div class="ai-head">
                <span class="ai-spark">✦</span>
                <span class="ai-title">Audioask</span>
                <span style="margin-left: auto; font-size: 10px; color: var(--ink-3); font-family: var(--mono);">SUR CET ÉPISODE</span>
              </div>
              <div class="ai-body">
                <div class="ai-bubble q">Quels sont les 3 paris clés racontés dans cet épisode&nbsp;?</div>
                <div class="ai-bubble a">
                  <div><span class="num">1.</span> Le pari sur <b>CUDA</b> en 2006 — investir massivement dans une couche logicielle propriétaire.</div>
                  <div style="margin-top: 6px;"><span class="num">2.</span> Le rachat de <b>Mellanox</b> en 2019 pour verrouiller le datacenter.</div>
                  <div style="margin-top: 6px;"><span class="num">3.</span> Le bet sur l'<b>IA générative</b> en 2018, deux ans avant ChatGPT.</div>
                  <div class="ai-cite"><span>↩</span><span>3 citations · </span><span class="ts">12:42</span><span class="ts">52:10</span><span class="ts">1:47:18</span></div>
                </div>
                <div class="ai-input">
                  <span style="color: var(--ink-3);">✎</span>
                  <span>Une autre question…</span>
                  <span class="send">→</span>
                </div>
              </div>
            </aside>
          </div>
          <div class="app-player">
            <div class="player-now">
              <img class="cv" src="/assets/pod-acquired.jpg" alt="" style="object-fit:cover;">
              <div><div class="ti">#119 — Nvidia</div><div class="sb">Acquired</div></div>
            </div>
            <div class="player-ctl">
              <span class="player-btn">«</span>
              <span class="player-btn play">▶</span>
              <span class="player-btn">»</span>
              <span class="player-ts">12:42</span>
              <span class="player-bar"><span class="fill"></span><span class="dot" style="left: 30%;"></span></span>
              <span class="player-ts">2:47:01</span>
            </div>
            <div class="player-right">
              <span style="padding: 2px 8px; border-radius: 6px; background: var(--cream-2); color: var(--ink-2);">×1.5</span>
              <span>⋯</span>
            </div>
          </div>
        </div>
          <div class="float seq" style="bottom: -24px; left: 8%; max-width: 200px; animation-delay: 3.7s;">
            <span class="lbl">Transcrit en</span>
            <span class="val" style="font-family: var(--serif); font-size: 28px; line-height: 1; letter-spacing: -0.02em;">2&nbsp;min&nbsp;48</span>
            <span style="font-size: 11px; color: var(--ink-3);">pour 2h 47min d'audio</span>
          </div>

        </div>
    </div>
  </div>
</section>

<!-- CE QUI CHANGE POUR VOUS -->
<section class="section paper">
  <div class="container">
    <div class="row between" style="align-items: flex-end; gap: 32px; flex-wrap: wrap;">
      <div>
        <div class="eyebrow"><span class="dot">●</span> {valueProps.eyebrow}</div>
        <h2 style="margin-top: 16px;">{valueProps.title}</h2>
      </div>
      <p class="lede" style="max-width: 36ch;">{valueProps.lede}</p>
    </div>

    <div class="feat-grid" style="margin-top: 48px;">
      <div class="feat-card">
        <span class="feat-num">01</span>
        <div class="feat-ico">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M16 16l5 5"/></svg>
        </div>
        <h3>{valueProps.cards[0].title}</h3>
        <p>{valueProps.cards[0].text}</p>
      </div>

      <div class="feat-card">
        <span class="feat-num">02</span>
        <div class="feat-ico">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <h3>{valueProps.cards[1].title}</h3>
        <p>{valueProps.cards[1].text}</p>
      </div>

      <div class="feat-card">
        <span class="feat-num">03</span>
        <div class="feat-ico">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg>
        </div>
        <h3>{valueProps.cards[2].title}</h3>
        <p>{valueProps.cards[2].text}</p>
      </div>

      <div class="feat-card">
        <span class="feat-num">04</span>
        <div class="feat-ico">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
        </div>
        <h3>{valueProps.cards[3].title}</h3>
        <p>{valueProps.cards[3].text}</p>
      </div>
    </div>
  </div>
</section>

<!-- INTERROGER — la confiance mise en avant -->
<section class="section">
  <div class="container">
    <div class="feature-alt" style="border-top: 0; padding-top: 0;">
      <div>
        <div class="eyebrow"><span class="dot">●</span> {ask.eyebrow}</div>
        <h3 style="margin-top: 12px; max-width: 22ch;">{ask.title}</h3>
        <p>{ask.lede}</p>
        <div class="pt-list">
          {ask.points.map(point => <span class="pt-item">{point}</span>)}
        </div>
      </div>
      <div class="demo" style="aspect-ratio: auto; padding: 22px; display: flex; flex-direction: column; gap: 7px;">
        <div style="font-family: var(--mono); font-size: 10px; color: var(--ink-3); letter-spacing: 0.08em;">ACQUIRED · #119 · 2h 47min</div>
        <div style="background: var(--cream-2); border: 1px solid var(--line); border-radius: 10px 10px 4px 10px; padding: 9px 13px; font-size: 12px; color: var(--ink); align-self: flex-end; max-width: 92%;">Quels sont les 3 paris clés racontés dans cet épisode&nbsp;?</div>
        <div style="background: var(--paper); border: 1px solid var(--line); border-radius: 4px 10px 10px 10px; padding: 10px 13px; font-size: 12px; color: var(--ink-2); line-height: 1.6;">
          <div><span style="color: var(--accent); font-weight: 600;">1.</span> Le pari sur <b>CUDA</b> en 2006.</div>
          <div><span style="color: var(--accent); font-weight: 600;">2.</span> Le rachat de <b>Mellanox</b> en 2019.</div>
          <div><span style="color: var(--accent); font-weight: 600;">3.</span> Le bet sur l'<b>IA générative</b> en 2018.</div>
          <div style="margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--line-2); font-size: 10.5px; color: var(--ink-3); display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
            <span>↩ 3 citations vérifiables</span>
            <span style="font-family: var(--mono); color: var(--accent-ink);">12:42</span>
            <span style="font-family: var(--mono); color: var(--accent-ink);">52:10</span>
            <span style="font-family: var(--mono); color: var(--accent-ink);">1:47:18</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<MobileTease uid="home" />

<!-- DÉCOUVRIR LES FONCTIONNALITÉS -->
<section class="section alt">
  <div class="container">
    <div class="row between" style="align-items: flex-end; gap: 32px; flex-wrap: wrap;">
      <div>
        <div class="eyebrow"><span class="dot">●</span> {discover.eyebrow}</div>
        <h2 style="margin-top: 16px;" set:html={discover.title}></h2>
      </div>
    </div>
    <div class="discover-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 48px;">
      <a href="/fonctionnalites/transcrire" class="discover-card">
        <div class="feat-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/></svg></div>
        <h4>{discover.cards.transcribe.title}</h4>
        <p>{discover.cards.transcribe.text}</p>
        <span class="discover-link">{discover.linkLabel} <span class="arrow">→</span></span>
      </a>
      <a href="/fonctionnalites/interroger" class="discover-card">
        <div class="feat-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l1.8 5.4L19 10l-5.2 1.6L12 17l-1.8-5.4L5 10l5.2-1.6L12 3z"/></svg></div>
        <h4>{discover.cards.ask.title}</h4>
        <p>{discover.cards.ask.text}</p>
        <span class="discover-link">{discover.linkLabel} <span class="arrow">→</span></span>
      </a>
      <a href="/fonctionnalites/automatiser" class="discover-card">
        <div class="feat-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg></div>
        <h4>{discover.cards.automate.title}</h4>
        <p>{discover.cards.automate.text}</p>
        <span class="discover-link">{discover.linkLabel} <span class="arrow">→</span></span>
      </a>
      <a href="/fonctionnalites/traduire" class="discover-card">
        <div style="position: absolute; top: 20px; right: 20px; padding: 3px 9px; background: var(--ink); color: var(--cream); font-family: var(--mono); font-size: 9px; letter-spacing: 0.08em; border-radius: 999px;">{discover.soonBadge}</div>
        <div class="feat-ico"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h12M9 3v3M11 12L7 6 3 12M14 15l5 5M19 20l-3-5-3 5M16 11h6"/></svg></div>
        <h4>{discover.cards.translate.title}</h4>
        <p>{discover.cards.translate.text}</p>
        <span class="discover-link">{discover.linkLabel} <span class="arrow">→</span></span>
      </a>
    </div>
  </div>
</section>

<!-- BIBLIOTHÈQUE PARTAGÉE — DARK -->
<section class="section dark xl">
  <div class="container">
    <div class="bignum-grid" style="display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: center;">
      <div>
        <div class="eyebrow" style="color: var(--accent);"><span class="dot">●</span> {library.eyebrow}</div>
        <h2 style="margin-top: 20px;" set:html={library.title}></h2>
        <p class="lede" style="font-size: 18px; margin-top: 20px;">{library.lede}</p>
      </div>
      <div style="text-align: right;">
        <div class="bignum">{library.bigNumber}</div>
        <div style="font-size: 18px; color: var(--night-text-2); margin-top: 12px; max-width: 24ch; margin-left: auto;" set:html={library.bigNumberCaption}></div>
        <div style="margin-top: 32px; display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; max-width: 380px; margin-left: auto;">
          {library.tags.map(tag => (
            <span style="padding: 4px 10px; background: var(--night-2); border: 1px solid var(--night-line); border-radius: 999px; font-size: 12px; color: var(--night-text-2);">{tag}</span>
          ))}
          <span style="padding: 4px 10px; background: var(--accent); color: white; border-radius: 999px; font-size: 12px;">{library.tagsMore}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PRICING TEASER -->
<section class="section">
  <div class="container">
    <div class="center" style="max-width: 720px; margin: 0 auto;">
      <div class="eyebrow"><span class="dot">●</span> {pricing.eyebrow}</div>
      <h2 style="margin-top: 16px;" set:html={pricing.title}></h2>
      <p class="lede" style="margin: 18px auto 0; text-align: center;">{pricing.lede}</p>
    </div>
    <div class="price-grid">
      <div class="plan">
        <div class="plan-head">
          <div class="plan-name">{pricing.free.name}</div>
          <span style="font-family: var(--mono); font-size: 10px; color: var(--ink-3); letter-spacing: 0.08em;">{pricing.free.tagline}</span>
        </div>
        <div class="price">{pricing.free.price}<small>&nbsp;{pricing.free.period}</small></div>
        <ul class="plan-feats">
