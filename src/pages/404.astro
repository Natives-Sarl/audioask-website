---
import Layout from '../layouts/Layout.astro';

// Page d'erreur unique pour les deux langues : Apache la sert quelle que soit
// l'URL demandée (voir ErrorDocument dans public/.htaccess), donc on ne sait
// pas dans quelle langue naviguait le visiteur. Les deux versions sont
// affichées, le français d'abord.
---

<Layout
  title="Page introuvable — Audioask"
  description="Cette page n'existe pas ou a été déplacée. Retrouvez l'accueil, les fonctionnalités et le blog d'Audioask."
  lang="fr"
  noindex={true}
>

<section class="hero" style="padding-top: 80px; padding-bottom: 60px; min-height: auto;">
  <div class="container">
    <div class="hero-copy" style="max-width: 720px;">
      <p class="eyebrow">Erreur 404</p>
      <h1 style="font-size: clamp(2rem, 4vw, 2.8rem);">Cette page n'existe pas.</h1>
      <p class="lede">
        Le lien est peut-être erroné, ou la page a été déplacée. Voici de quoi
        reprendre votre visite.
      </p>
      <div class="hero-ctas" style="margin-top: 28px;">
        <a class="btn btn-primary lg" href="/">Retour à l'accueil <span class="arrow">→</span></a>
        <a class="btn btn-ghost lg" href="/contact">Nous contacter</a>
      </div>

      <p class="small" style="margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line);">
        <b>Page not found.</b> The link may be wrong, or the page may have moved.
        <a href="/en/" style="color: var(--accent-ink); border-bottom: 1px solid currentColor;">Back to the homepage</a>
        &nbsp;·&nbsp;
        <a href="/en/contact" style="color: var(--accent-ink); border-bottom: 1px solid currentColor;">Contact us</a>
      </p>
    </div>
  </div>
</section>

<section class="section paper">
  <div class="container" style="max-width: 820px;">
    <h2 style="margin-bottom: 20px;">Les pages les plus consultées</h2>
    <div class="discover-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;">
      <a href="/fonctionnalites/transcrire" class="discover-card">
        <h4>Transcrire</h4>
        <p>De l'audio au texte structuré en quelques minutes.</p>
        <span class="discover-link">En savoir plus <span class="arrow">→</span></span>
      </a>
      <a href="/fonctionnalites/interroger" class="discover-card">
        <h4>Interroger</h4>
        <p>Posez vos questions, l'épisode répond — avec citations.</p>
        <span class="discover-link">En savoir plus <span class="arrow">→</span></span>
      </a>
      <a href="/tarifs" class="discover-card">
        <h4>Tarifs</h4>
        <p>Gratuit pour démarrer, 3€ par mois pour aller plus loin.</p>
        <span class="discover-link">Voir les tarifs <span class="arrow">→</span></span>
      </a>
      <a href="/blog" class="discover-card">
        <h4>Blog</h4>
        <p>Nos articles sur le podcast, la transcription et l'IA.</p>
        <span class="discover-link">Lire le blog <span class="arrow">→</span></span>
      </a>
    </div>
  </div>
</section>

</Layout>

<style>
  @media (max-width: 768px) {
    .discover-grid { grid-template-columns: 1fr !important; }
  }
</style>
